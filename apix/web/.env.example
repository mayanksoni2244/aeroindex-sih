# Dashboard configuration. Copy to `.env.local` and edit as needed.
#
# VITE_ variables are inlined into the browser bundle at build time. Anything
# here is public once the site is served — do not put a real secret in this
# file. See the note at the top of src/api.js.

# Where the API lives. Leave empty in development: vite.config.js proxies
# /v1 to APIX_API_URL (default http://127.0.0.1:8000), which keeps the browser
# on one origin and avoids CORS entirely.
VITE_APIX_API_URL=

# Must match APIX_API_KEY on the server. The default below matches the API's
# own development default (apix/.env.example), so a fresh checkout works with
# no configuration.
VITE_APIX_API_KEY=dev-nso-rbi-key
