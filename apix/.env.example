# ─────────────────────────────────────────────────────────────────────────────
# AeroIndex APIx — environment configuration
# Copy to .env and adjust.  Every value here is read by apix/config/settings.py.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------------
# Docker Compose sets the PostgreSQL URL below.
# For a local run WITHOUT Docker, a SQLite fallback is used automatically
# (sqlite:///./apix.db) so tests and the demo still work on any machine.
APIX_DATABASE_URL=postgresql+psycopg://apix:apix@localhost:5432/apix

# --- API ----------------------------------------------------------------------
# API key required by /v1 endpoints via the `X-API-Key` header.
# Models the controlled NSO/RBI access described in the problem statement.
APIX_API_KEY=dev-nso-rbi-key
APIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scraping (Tier A, live) --------------------------------------------------
# Comma-separated adapter keys from `apix/scrape/live/REGISTRY`.
# There is deliberately no singular APIX_LIVE_SOURCE: two settings for one
# concept let the API report a source that never ran.
# Empirically chosen: akasa's robots.txt declares no Disallow rules, and it is
# the only source registered. An unregistered key is not fatal — the cycle
# records ADAPTER_UNAVAILABLE for it and carries on — which is why a typo here
# shows up as a coverage line rather than an error.
APIX_LIVE_SOURCES=akasa
# Identifies us honestly to the origin server. Never spoofed to mimic a browser.
APIX_SCRAPER_USER_AGENT=AeroIndex-Research/0.1 (SIH26056 academic prototype; contact: team-scalex@example.edu)
# Token-bucket polite rate limiting. This is the hard ceiling — no flag raises it.
APIX_SCRAPE_RATE_PER_MIN=6
APIX_SCRAPE_MAX_RETRIES=2
APIX_SCRAPE_TIMEOUT_MS=30000
# How many route x window cells are in flight at once. This does NOT raise the
# request rate — every search still passes the shared TokenBucket above. Each
# in-flight cell is a real browser page, so keep this small.
APIX_LIVE_CONCURRENCY=4
# Routes attempted live. Leave this at the default set: the Live Index uses only
# the four Akasa non-stop routes (DEL-BOM, DEL-BLR, BOM-BLR, DEL-CCU) regardless
# of what is listed here. Narrowing it does not change the published basket, it
# only stops the run producing the two connection-only cells that prove
# BLR-HYD and MAA-DEL are genuinely not sold non-stop.
APIX_LIVE_ROUTES=DEL-BOM,DEL-BLR,BOM-BLR,DEL-CCU,BLR-HYD,MAA-DEL

# --- Simulation (Tier B) ------------------------------------------------------
# Deterministic given this seed — reruns reproduce identical synthetic data.
APIX_SIM_SEED=20260909

# --- Cleaning -----------------------------------------------------------------
# Max age (days) of a last-known-good quote usable for imputation.
APIX_IMPUTE_MAX_AGE_DAYS=3

# --- Index --------------------------------------------------------------------
# Elementary aggregation formula: jevons (default, CPI standard) or dutot.
APIX_ELEMENTARY_FORMULA=jevons
# Base period for index=100. Blank => first period with data.
APIX_BASE_PERIOD=
